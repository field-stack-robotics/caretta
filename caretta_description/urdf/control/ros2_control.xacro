<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="caretta_ros2_control" params="robot_name controllers_file">

    <ros2_control name="CarettaGazeboSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:macro name="caretta_wheel_interface" params="joint">
        <joint name="${joint}">
          <command_interface name="velocity">
            <param name="min">${-max_wheel_speed}</param>
            <param name="max">${max_wheel_speed}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>

      <xacro:caretta_wheel_interface joint="${robot_name}_left_wheel"/>
      <xacro:caretta_wheel_interface joint="${robot_name}_right_wheel"/>
    </ros2_control>

    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
