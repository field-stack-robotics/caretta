<?xml version="1.0" ?>
<!-- Raspberry Pi camera. Needs the Sensors system in the world. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="camera" params="robot_name parent xyz rpy:='0 0 0' sim:=false">

    <link name="${robot_name}_camera">
        <inertial>
            <origin xyz="-0.003 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://caretta_description/urdf/meshes/raspicam.stl"/>
            </geometry>
            <xacro:fs1_material name="fs1_camera_pcb"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://caretta_description/urdf/meshes/raspicam.stl"/>
            </geometry>
        </collision>
    </link>

    <joint name="${robot_name}_camera_joint" type="fixed">
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <parent link="${parent}"/>
        <child link="${robot_name}_camera"/>
    </joint>

    <!-- optical frame: frame_id of the images -->
    <link name="${robot_name}_camera_optical"/>

    <joint name="${robot_name}_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
        <parent link="${robot_name}_camera"/>
        <child link="${robot_name}_camera_optical"/>
    </joint>

    <xacro:if value="${sim}">
      <!-- Gazebo cameras look along +x of the link -->
      <gazebo reference="${robot_name}_camera">
        <sensor name="${robot_name}_camera" type="camera">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>30</update_rate>
          <topic>camera/image_raw</topic>
          <ignition_frame_id>${robot_name}_camera_optical</ignition_frame_id>
          <camera name="${robot_name}_head">
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>800</width>
              <height>800</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.02</near>
              <far>300</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
