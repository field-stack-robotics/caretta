<?xml version="1.0" ?>
<!-- Gazebo (Ignition Fortress) sensors: LSLiDAR N10 (gpu_lidar) and Raspberry Pi camera.
     Fortress: sensor publishes on a gz topic, ros_gz_bridge turns it into sensor_msgs/LaserScan.
     The world must load the gz::sim::systems::Sensors plugin (see caretta_gazebo/worlds). -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="caretta_sensors_gazebo" params="robot_name">

    <!-- LSLiDAR N10: frame at the scan plane (caretta_laser) -->
    <gazebo reference="${robot_name}_laser">
      <sensor name="${robot_name}_lslidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <ignition_frame_id>${robot_name}_laser</ignition_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>270</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.141593</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>20.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- Raspberry Pi camera. Gazebo cameras look along +X of the link, so the
         sensor sits on caretta_camera (lens, x forward); images carry the ROS optical frame.
         The camera-pod wall is 3.8 mm in front of the lens, inside the 0.02 m near clip. -->
    <gazebo reference="${robot_name}_camera">
      <sensor name="${robot_name}_camera" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>30</update_rate>
        <topic>camera/image_raw</topic>           <!-- camera info: camera/camera_info -->
        <ignition_frame_id>${robot_name}_camera_optical</ignition_frame_id>
        <camera name="${robot_name}_head">
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>800</width>
            <height>800</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
