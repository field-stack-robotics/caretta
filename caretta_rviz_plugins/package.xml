<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caretta_rviz_plugins</name>
  <version>0.0.0</version>
  <description>Caretta RViz plugins: GPS goal panel (type latitude/longitude, send a Nav2 goal)</description>
  <maintainer email="oguzhan@fieldstackrobotics.com">Oguzhan Gurbuz</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <depend>geographic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>qtbase5-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
