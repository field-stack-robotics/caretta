<?xml version="1.0" ?>
<!-- FS-1 Caretta- base_link: axle midpoint on the ground, x forward, z up. -->
<robot name="caretta" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="use_gazebo" default="false"/>
  <!-- set by the launch file -->
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="gps" default="false"/>

  <xacro:include filename="$(find caretta_description)/urdf/caretta_materials.xacro"/>
  <xacro:include filename="$(find caretta_description)/urdf/sensors/lidar.xacro"/>
  <xacro:include filename="$(find caretta_description)/urdf/sensors/camera.xacro"/>
  <xacro:include filename="$(find caretta_description)/urdf/sensors/imu.xacro"/>
  <xacro:include filename="$(find caretta_description)/urdf/sensors/gps.xacro"/>

  <xacro:property name="PI" value="3.141592653589793" />
  <xacro:property name="wheel_radius" value="0.0345" />
  <xacro:property name="wheel_width" value="0.0248" />
  <xacro:property name="wheel_separation" value="0.2092" />
  <!-- ASSUMED: measure the real motor -->
  <xacro:property name="max_wheel_speed" value="18.0" />  <!-- rad/s -->
  <xacro:property name="wheel_effort" value="0.1" />       <!-- N*m -->
  <xacro:property name="caster_x" value="0.1270" />
  <xacro:property name="caster_radius" value="0.0060" />
  <!-- middle of the lidar head -->
  <xacro:property name="lidar_scan_height" value="0.029" />

  <xacro:macro name="caretta_body" params="robot_name">

    <!-- no inertia (KDL) -->
    <link name="${robot_name}_base_footprint"/>

    <joint name="${robot_name}_base_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${robot_name}_base_footprint"/>
        <child link="${robot_name}_base_link"/>
    </joint>

    <link name="${robot_name}_base_link">
        <inertial>
            <!-- TODO: weigh the real robot -->
            <origin xyz="-0.045 0 0.065" rpy="0 0 0"/>
            <mass value="0.65"/>
            <inertia ixx="0.002535" ixy="0" ixz="0" iyy="0.002947" iyz="0" izz="0.003922"/>
        </inertial>
        <!-- one link per colour: urdfdom colours one visual per link -->
        <visual name="base_link_black">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://caretta_description/urdf/meshes/base_link_black.stl"/>
            </geometry>
            <xacro:fs1_material name="fs1_black"/>
        </visual>
        <!-- boxes instead of the mesh -->
        <collision>
            <origin xyz="-0.0411 0 0.0687" rpy="0 0 0"/>
            <geometry>
                <box size="0.2078 0.180 0.0970"/>
            </geometry>
        </collision>
        <collision>
            <origin xyz="-0.103 -0.048 0.1267" rpy="0 0 0"/>
            <geometry>
                <box size="0.030 0.030 0.019"/>
            </geometry>
        </collision>
    </link>

    <xacro:macro name="caretta_part" params="name mesh material parent">
      <link name="${robot_name}_${name}">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://caretta_description/urdf/meshes/${mesh}.stl"/>
            </geometry>
            <xacro:fs1_material name="${material}"/>
        </visual>
      </link>
      <joint name="${robot_name}_${name}_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${parent}"/>
        <child link="${robot_name}_${name}"/>
      </joint>
    </xacro:macro>

    <xacro:caretta_part name="standoffs"     mesh="base_link_brass" material="fs1_brass"        parent="${robot_name}_base_link"/>
    <xacro:caretta_part name="teal_inlays"   mesh="base_link_teal"  material="fs1_teal"         parent="${robot_name}_base_link"/>
    <xacro:caretta_part name="amber_inlays"  mesh="base_link_amber" material="fs1_amber"        parent="${robot_name}_base_link"/>
    <xacro:caretta_part name="estop_housing" mesh="estop_housing"   material="fs1_estop_yellow" parent="${robot_name}_base_link"/>
    <xacro:caretta_part name="estop_button"  mesh="estop_button"    material="fs1_estop_red"    parent="${robot_name}_base_link"/>

    <xacro:macro name="caretta_motor_link" params="name">
      <link name="${robot_name}_${name}">
        <inertial>
            <origin xyz="-0.024 0 0" rpy="0 0 0"/>
            <mass value="0.0339689"/>
            <inertia ixx="2.46e-06" ixy="0" ixz="0" iyy="1.957e-05" iyz="0" izz="1.916e-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://caretta_description/urdf/meshes/caretta_motor.stl"/>
            </geometry>
            <xacro:fs1_material name="fs1_motor_yellow"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://caretta_description/urdf/meshes/caretta_motor.stl"/>
            </geometry>
        </collision>
      </link>
    </xacro:macro>

    <xacro:macro name="caretta_wheel_link" params="name">
      <link name="${robot_name}_${name}">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.03"/>
            <inertia ixx="1.046e-05" ixy="0" ixz="0" iyy="1.785e-05" iyz="0" izz="1.046e-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://caretta_description/urdf/meshes/wheel_rim.stl"/>
            </geometry>
            <xacro:fs1_material name="fs1_rim_yellow"/>
        </visual>
        <!-- sphere: one contact at the tyre centre (a cylinder turned 13 % too fast) -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
        </collision>
      </link>
      <xacro:caretta_part name="tire_${name.split('_')[1]}" mesh="wheel_tire" material="fs1_tire" parent="${robot_name}_${name}"/>
    </xacro:macro>

    <xacro:caretta_motor_link name="motor_1"/>
    <xacro:caretta_wheel_link name="wheel_right"/>

    <joint name="${robot_name}_right_wheel" type="continuous">
        <origin xyz="0 -0.0271 0" rpy="0 0 0"/>
        <parent link="${robot_name}_motor_1"/>
        <child link="${robot_name}_wheel_right"/>
        <axis xyz="0 1 0"/>
        <limit effort="${wheel_effort}" velocity="${max_wheel_speed}"/>
        <dynamics damping="0.001" friction="0.001"/>
    </joint>

    <joint name="${robot_name}_right_motor" type="fixed">
        <origin xyz="0 -0.0775 0.0345" rpy="0 0 0"/>
        <parent link="${robot_name}_base_link"/>
        <child link="${robot_name}_motor_1"/>
    </joint>

    <xacro:caretta_motor_link name="motor_2"/>
    <xacro:caretta_wheel_link name="wheel_left"/>

    <joint name="${robot_name}_left_wheel" type="continuous">
        <origin xyz="0 0.0271 0" rpy="0 0 0"/>
        <parent link="${robot_name}_motor_2"/>
        <child link="${robot_name}_wheel_left"/>
        <axis xyz="0 1 0"/>
        <limit effort="${wheel_effort}" velocity="${max_wheel_speed}"/>
        <dynamics damping="0.001" friction="0.001"/>
    </joint>

    <joint name="${robot_name}_left_motor" type="fixed">
        <origin xyz="0 0.0775 0.0345" rpy="0 0 0"/>
        <parent link="${robot_name}_base_link"/>
        <child link="${robot_name}_motor_2"/>
    </joint>

    <!-- scan plane 0.146 m, above the e-stop -->
    <xacro:lidar robot_name="${robot_name}" parent="${robot_name}_base_link"
                 xyz="0 0 0.1172" scan_height="${lidar_scan_height}" sim="$(arg use_gazebo)"/>

    <!-- above the rotation centre: no false centripetal acceleration -->
    <xacro:imu robot_name="${robot_name}" parent="${robot_name}_base_link"
               xyz="0 0 0.075" sim="$(arg use_gazebo)"/>

    <xacro:if value="$(arg gps)">
      <xacro:dual_gps robot_name="${robot_name}" parent="${robot_name}_base_link"
                      sim="$(arg use_gazebo)"/>
    </xacro:if>

    <xacro:camera robot_name="${robot_name}" parent="${robot_name}_base_link"
                  xyz="0.0590 0 0.0982" sim="$(arg use_gazebo)"/>

    <link name="${robot_name}_ball_caster">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="1e-07" ixy="0" ixz="0" iyy="1e-07" iyz="0" izz="1e-07"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://caretta_description/urdf/meshes/pololu_ball_caster.stl"/>
            </geometry>
            <xacro:fs1_material name="fs1_caster"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
    </link>

    <joint name="${robot_name}_caster_joint" type="fixed">
        <origin xyz="${-caster_x} 0 ${caster_radius}" rpy="0 0 0"/>
        <parent link="${robot_name}_base_link"/>
        <child link="${robot_name}_ball_caster"/>
    </joint>

    <gazebo reference="${robot_name}_ball_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

    <gazebo reference="${robot_name}_wheel_left">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="${robot_name}_wheel_right">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

  </xacro:macro>

  <xacro:caretta_body robot_name="caretta"/>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find caretta_description)/urdf/control/ros2_control.xacro"/>
    <xacro:caretta_ros2_control robot_name="caretta" controllers_file="$(arg controllers_file)"/>
  </xacro:if>

</robot>
